# =====================================================================
# Hollow Creek — fichier de configuration
# Copiez ce fichier en « .env » et remplissez les valeurs marquées [à remplir].
# Ne publiez jamais le fichier .env : il contient vos mots de passe.
# =====================================================================

APP_NAME="Hollow Creek"
# production sur Alwaysdata ; local sur un ordinateur de développement
APP_ENV=production
# Clé de chiffrement : générée par « php artisan key:generate ». À conserver précieusement.
APP_KEY=
# Toujours false en production (sinon les erreurs affichent des informations sensibles).
APP_DEBUG=false
# Adresse du site, sans barre finale [à remplir], ex. https://hollowcreek.alwaysdata.net
APP_URL=https://hollowcreek.alwaysdata.net
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux techniques : un fichier par jour, gardés 30 jours (place limitée sur l'offre gratuite).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de données MariaDB (Alwaysdata › Bases de données › MySQL) ---
DB_CONNECTION=mariadb
# [à remplir] mysql-VOTRECOMPTE.alwaysdata.net
DB_HOST=mysql-VOTRECOMPTE.alwaysdata.net
DB_PORT=3306
# [à remplir] VOTRECOMPTE_hollowcreek
DB_DATABASE=VOTRECOMPTE_hollowcreek
# [à remplir]
DB_USERNAME=VOTRECOMPTE
# [à remplir]
DB_PASSWORD=

# --- Sessions : stockées en base, cookies sécurisés ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# File d'attente en base. Sur l'offre gratuite, elle est traitée par la tâche planifiée.
QUEUE_CONNECTION=database
HOLLOW_QUEUE_VIA_SCHEDULER=true

# --- E-mails (Alwaysdata : smtp-VOTRECOMPTE.alwaysdata.net) ---
# Avant d'avoir une adresse d'envoi sur votre domaine, laissez MAIL_MAILER=log :
# les e-mails sont alors écrits dans storage/logs au lieu d'être envoyés.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp-VOTRECOMPTE.alwaysdata.net
MAIL_PORT=465
# Adresse complète de la boîte d'envoi et son mot de passe
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ne-pas-repondre@votre-domaine.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications push (téléphones, ordinateurs) : laissées vides, elles sont créées au
# déploiement par « php artisan hollow:cles-push ». Ne pas les changer ensuite.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
# Contact donné aux services push (Google, Apple…) ; par défaut MAIL_FROM_ADDRESS.
# WEBPUSH_SUBJECT="mailto:contact@votre-domaine.fr"

# --- Réglages propres à Hollow Creek ---
# Valeurs de départ ; ensuite, tout se règle dans l'administration (Réglages).
HOLLOW_REGISTRATIONS_OPEN=false
HOLLOW_RP_DATE="Jeudi 5 novembre 2026"
# Double authentification obligatoire pour l'équipe (laisser à true)
HOLLOW_STAFF_TWO_FACTOR=true
# Lire l'adresse IP réelle des visiteurs transmise par le proxy d'Alwaysdata (laisser à true)
HOLLOW_TRUST_HOSTING_PROXY=true
# À passer à true une fois le site vérifié en HTTPS (en-tête HSTS)
HOLLOW_HSTS=false

# --- Sauvegardes ---
# Mot de passe qui chiffre les archives [à remplir, et à garder hors du serveur]
BACKUP_ARCHIVE_PASSWORD=
# Adresse qui reçoit le compte rendu de chaque sauvegarde [à remplir]
BACKUP_NOTIFICATION_EMAIL=
# Place maximale occupée par les archives sur le serveur (en Mo)
BACKUP_MAX_LOCAL_MEGABYTES=250
# Stockage externe compatible S3, en Europe (facultatif mais conseillé).
# Laisser BACKUP_EXTERNAL_BUCKET vide pour ne pas l'utiliser.
BACKUP_EXTERNAL_BUCKET=
BACKUP_EXTERNAL_ENDPOINT=
BACKUP_EXTERNAL_REGION=
BACKUP_EXTERNAL_KEY=
BACKUP_EXTERNAL_SECRET=
BACKUP_EXTERNAL_PATH_STYLE=true

VITE_APP_NAME="${APP_NAME}"
